{
  "name": "@symphoria/verify",
  "version": "0.1.0",
  "description": "Verify a Symphoria investigation export against Bitcoin without Symphoria's cooperation. Recomputes SHA-256 content hashes, walks Merkle paths, verifies Ed25519 signatures, confirms OpenTimestamps proofs against Bitcoin.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "symphoria-verify": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "node --test --experimental-test-coverage dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "javascript-opentimestamps": "^0.4.5",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "symphoria",
    "tamper-evident",
    "merkle",
    "bitcoin",
    "opentimestamps",
    "ed25519",
    "verification",
    "civic-ledger"
  ]
}
